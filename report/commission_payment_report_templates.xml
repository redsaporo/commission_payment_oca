<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="report_commission_payment">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="s">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 class="text-center mb-4">Resumen de Pago de Comisiones</h2>
                        <div class="row mb-4">
                            <div class="col-6">
                                <table class="table table-sm table-borderless">
                                    <tr>
                                        <td class="fw-bold" style="width:40%">Agente:</td>
                                        <td><t t-esc="s.agent_id.name" /></td>
                                    </tr>
                                    <tr>
                                        <td class="fw-bold">Período:</td>
                                        <td>
                                            <t t-esc="s.date_from" t-options='{"widget": "date"}' />
                                            a
                                            <t t-esc="s.date_to" t-options='{"widget": "date"}' />
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="fw-bold">Estado:</td>
                                        <td>
                                            <span t-if="s.state == 'paid'" class="badge bg-success">PAGADO</span>
                                            <span t-elif="s.state == 'invoiced'" class="badge bg-info">Facturado</span>
                                            <span t-elif="s.state == 'settled'" class="badge bg-warning">Liquidado</span>
                                            <span t-else="" class="badge bg-secondary">Cancelado</span>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                            <div class="col-6">
                                <table class="table table-sm table-borderless">
                                    <tr>
                                        <td class="fw-bold" style="width:40%">Comisión Total:</td>
                                        <td>
                                            <t t-esc="s.total"
                                               t-options='{"widget": "monetary", "display_currency": s.currency_id}' />
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="fw-bold">Pagado:</td>
                                        <td class="text-success">
                                            <t t-esc="s.amount_paid"
                                               t-options='{"widget": "monetary", "display_currency": s.currency_id}' />
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="fw-bold">Pendiente:</td>
                                        <td t-attf-class="#{'text-danger fw-bold' if s.amount_residual > 0 else ''}">
                                            <t t-esc="s.amount_residual"
                                               t-options='{"widget": "monetary", "display_currency": s.currency_id}' />
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <h5>Líneas de Comisión</h5>
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Fecha</th>
                                    <th>Comisión</th>
                                    <th>Factura Origen</th>
                                    <th>Cliente</th>
                                    <th class="text-end">Importe</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="s.line_ids" t-as="line">
                                    <tr>
                                        <td><t t-esc="line.date" t-options='{"widget": "date"}' /></td>
                                        <td><t t-esc="line.commission_id.name" /></td>
                                        <td>
                                            <t t-if="hasattr(line, 'invoice_agent_line_id') and line.invoice_agent_line_id and line.invoice_agent_line_id.invoice_id">
                                                <t t-esc="line.invoice_agent_line_id.invoice_id.name" />
                                            </t>
                                        </td>
                                        <td>
                                            <t t-if="hasattr(line, 'invoice_agent_line_id') and line.invoice_agent_line_id and line.invoice_agent_line_id.invoice_id">
                                                <t t-esc="line.invoice_agent_line_id.invoice_id.partner_id.name" />
                                            </t>
                                        </td>
                                        <td class="text-end">
                                            <t t-esc="line.settled_amount"
                                               t-options='{"widget": "monetary", "display_currency": s.currency_id}' />
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                            <tfoot>
                                <tr class="fw-bold border-top">
                                    <td colspan="4">Total</td>
                                    <td class="text-end">
                                        <t t-esc="s.total"
                                           t-options='{"widget": "monetary", "display_currency": s.currency_id}' />
                                    </td>
                                </tr>
                            </tfoot>
                        </table>

                        <t t-if="s.payment_line_ids">
                            <h5 class="mt-4">Registros de Pago</h5>
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Fecha</th>
                                        <th>Referencia</th>
                                        <th class="text-end">Importe</th>
                                        <th>Notas</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="s.payment_line_ids" t-as="p">
                                        <tr>
                                            <td><t t-esc="p.date" t-options='{"widget": "date"}' /></td>
                                            <td><t t-esc="p.reference or '-'" /></td>
                                            <td class="text-end">
                                                <t t-esc="p.amount"
                                                   t-options='{"widget": "monetary", "display_currency": s.currency_id}' />
                                            </td>
                                            <td><t t-esc="p.notes or ''" /></td>
                                        </tr>
                                    </t>
                                </tbody>
                                <tfoot>
                                    <tr class="fw-bold border-top text-success">
                                        <td colspan="2">Total Pagado</td>
                                        <td class="text-end">
                                            <t t-esc="s.amount_paid"
                                               t-options='{"widget": "monetary", "display_currency": s.currency_id}' />
                                        </td>
                                        <td />
                                    </tr>
                                </tfoot>
                            </table>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
