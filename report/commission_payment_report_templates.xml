<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="report_commission_payment">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="s">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 class="text-center mb-4">Commission Payment Summary</h2>
                        <div class="row mb-4">
                            <div class="col-6">
                                <table class="table table-sm table-borderless">
                                    <tr>
                                        <td class="fw-bold" style="width:40%">Agent:</td>
                                        <td><t t-esc="s.agent_id.name" /></td>
                                    </tr>
                                    <tr>
                                        <td class="fw-bold">Period:</td>
                                        <td>
                                            <t t-esc="s.date_from" t-options='{"widget": "date"}' />
                                            to
                                            <t t-esc="s.date_to" t-options='{"widget": "date"}' />
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="fw-bold">Status:</td>
                                        <td>
                                            <span t-if="s.state == 'paid'" class="badge bg-success">PAID</span>
                                            <span t-elif="s.state == 'invoiced'" class="badge bg-info">Invoiced</span>
                                            <span t-elif="s.state == 'settled'" class="badge bg-warning">Settled</span>
                                            <span t-else="" class="badge bg-secondary">Cancelled</span>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                            <div class="col-6">
                                <table class="table table-sm table-borderless">
                                    <tr>
                                        <td class="fw-bold" style="width:40%">Total Commission:</td>
                                        <td>
                                            <t t-esc="s.total"
                                               t-options='{"widget": "monetary", "display_currency": s.currency_id}' />
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="fw-bold">Paid:</td>
                                        <td class="text-success">
                                            <t t-esc="s.amount_paid"
                                               t-options='{"widget": "monetary", "display_currency": s.currency_id}' />
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="fw-bold">Pending:</td>
                                        <td t-attf-class="#{'text-danger fw-bold' if s.amount_residual > 0 else ''}">
                                            <t t-esc="s.amount_residual"
                                               t-options='{"widget": "monetary", "display_currency": s.currency_id}' />
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <h5>Commission Lines</h5>
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Commission</th>
                                    <th>Source Invoice</th>
                                    <th>Customer</th>
                                    <th class="text-end">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="s.line_ids" t-as="line">
                                    <tr>
                                        <td><t t-esc="line.date" t-options='{"widget": "date"}' /></td>
                                        <td><t t-esc="line.commission_id.name" /></td>
                                        <td><t t-esc="line.source_invoice_id.name" /></td>
                                        <td><t t-esc="line.source_partner_id.name" /></td>
                                        <td class="text-end">
                                            <t t-esc="line.settled_amount"
                                               t-options='{"widget": "monetary", "display_currency": s.currency_id}' />
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                            <tfoot>
                                <tr class="fw-bold border-top">
                                    <td colspan="4">Total</td>
                                    <td class="text-end">
                                        <t t-esc="s.total"
                                           t-options='{"widget": "monetary", "display_currency": s.currency_id}' />
                                    </td>
                                </tr>
                            </tfoot>
                        </table>

                        <t t-if="s.payment_detail_ids">
                            <h5 class="mt-4">Payment Records</h5>
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Number</th>
                                        <th>Date</th>
                                        <th>Reference</th>
                                        <th class="text-end">Amount</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="s.payment_detail_ids" t-as="d">
                                        <tr>
                                            <td><t t-esc="d.payment_id.name" /></td>
                                            <td><t t-esc="d.payment_id.date" t-options='{"widget": "date"}' /></td>
                                            <td><t t-esc="d.payment_id.reference or '-'" /></td>
                                            <td class="text-end">
                                                <t t-esc="d.amount"
                                                   t-options='{"widget": "monetary", "display_currency": s.currency_id}' />
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                                <tfoot>
                                    <tr class="fw-bold border-top text-success">
                                        <td colspan="3">Total Paid</td>
                                        <td class="text-end">
                                            <t t-esc="s.amount_paid"
                                               t-options='{"widget": "monetary", "display_currency": s.currency_id}' />
                                        </td>
                                    </tr>
                                </tfoot>
                            </table>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
